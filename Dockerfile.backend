FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1
WORKDIR /app

COPY pyproject.toml ./
COPY stockwise ./stockwise
COPY alembic ./alembic
COPY alembic.ini ./alembic.ini
COPY scripts/start_backend.sh ./scripts/start_backend.sh
RUN python -m pip install --upgrade pip && python -m pip install . \
    && groupadd --system --gid 10001 stockwise \
    && useradd --system --uid 10001 --gid stockwise --home-dir /app --no-create-home stockwise \
    && chmod 0555 /app/scripts/start_backend.sh \
    && chown -R stockwise:stockwise /app

USER 10001:10001
EXPOSE 8000
CMD ["/app/scripts/start_backend.sh"]
