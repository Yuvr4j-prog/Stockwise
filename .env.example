POSTGRES_DB=stockwise
POSTGRES_USER=stockwise
POSTGRES_PASSWORD=local-only-change-me
POSTGRES_PORT=5432
APP_PORT=8080
# Host-run backend/test URL. Compose constructs its own service-network URL.
DATABASE_URL=postgresql+psycopg://stockwise:local-only-change-me@127.0.0.1:5432/stockwise
JWT_SECRET=replace-with-a-random-secret-before-deploying
FRONTEND_ORIGIN=http://127.0.0.1:8080
ENVIRONMENT=development
MAX_UPLOAD_BYTES=10485760
PORT=8000
PYTHON_VERSION=3.12

# Set these while building the Next.js image. Leave both blank for the local
# same-origin Caddy proxy. BACKEND_URL is the remote API origin on Vercel.
NEXT_PUBLIC_API_BASE_URL=
BACKEND_URL=
SEED_DEMO=0
